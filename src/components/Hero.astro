---
import type { SitePageContent } from "../lib/dato";

interface Props {
  content?: SitePageContent;
}

const { content } = Astro.props;
const eyebrow = content?.eyebrow ?? "Para empresas mexicanas donde el downtime tiene un costo medible.";
const heading = content?.heading ?? "Las redes se caen. Tu negocio no.";
const [headingStart, headingAccent] = heading.includes("|")
  ? heading.split("|", 2)
  : [heading, ""];
const intro = content?.intro ?? "Vialterna es la capa de resiliencia multinetwork para grandes empresas distribuidas en México: independiente de red y tecnología, monitoreada 24/7 y respaldada por SLA. No vendemos un enlace. Entregamos continuidad operativa.";
const ctaLabel = content?.ctaLabel ?? "Solicita tu auditoría Telco gratuita";
const ctaHref = content?.ctaHref ?? "/contacto/";
const secondaryCtaLabel = content?.secondaryCtaLabel ?? "Habla con un experto";
const secondaryCtaHref = content?.secondaryCtaHref ?? "/contacto/";
---
<section class="hero">
  <div class="shell hero-grid">
    <div class="hero-content">
      <div class="eyebrow reveal">{eyebrow}</div>
      <h1 class="reveal">{headingStart.trim()} {headingAccent && <span class="accent">{headingAccent.trim()}</span>}</h1>
      <p class="hero-copy reveal">{intro}</p>
      <div class="actions reveal">
        <a class="button primary" href={ctaHref}>{ctaLabel}</a>
        <a class="button" href={secondaryCtaHref}>{secondaryCtaLabel}</a>
      </div>
    </div>
    <div class="network-scene" aria-hidden="true">
      <div class="orbit orbit-outer"><i></i><i></i><i></i><i></i></div>
      <div class="orbit orbit-middle"></div>
      <div class="orbit orbit-inner"></div>
      <div class="network-center"><strong>NOC</strong><span>24 / 7</span></div>
      <span class="tech-label label-fiber">Fibra</span>
      <span class="tech-label label-lte">LTE</span>
      <span class="tech-label label-5g">5G</span>
      <span class="tech-label label-sat">Satelital</span>
    </div>
  </div>
</section>
<div class="capabilities" aria-label="Capacidades Vialterna">
  <div class="capabilities-track">
    {[0, 1].map(() => <span>Multioperador <i></i> Respaldo automático <i></i> SLA gestionado <i></i> Cobertura nacional <i></i> Monitoreo 24/7 <i></i></span>)}
  </div>
</div>
