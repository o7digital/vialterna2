<div class="olivia" data-olivia>
  <section class="olivia__panel" hidden aria-hidden="true">
    <header>
      <div>
        <strong>Olivia</strong>
        <small data-subtitle>Asistente Vialterna · En línea</small>
      </div>
      <span class="olivia__status"><i></i><b data-status>En línea</b></span>
      <button data-close aria-label="Cerrar">×</button>
    </header>
    <div class="olivia__messages" data-messages>
      <p class="bot" data-welcome>Hola, soy Olivia. ¿Cómo puedo ayudarte con la conectividad de tu empresa?</p>
    </div>
    <nav class="olivia__scroll-controls" aria-label="Navegar en la conversación">
      <button type="button" data-scroll-up aria-label="Mensajes anteriores">↑</button>
      <button type="button" data-scroll-down aria-label="Mensajes siguientes">↓</button>
    </nav>
    <form data-form>
      <label><input type="checkbox" data-consent /> <span><span data-consent-label>Acepto compartir mis datos para recibir atención de Vialterna.</span> <button type="button" class="olivia__privacy-link" data-privacy-open>Aviso de Privacidad</button></span></label>
      <div class="olivia__lead-fields" data-lead-fields hidden>
        <input data-first-name placeholder="Nombre" autocomplete="given-name" />
        <input data-last-name placeholder="Apellido" autocomplete="family-name" />
        <input data-company placeholder="Empresa" autocomplete="organization" />
        <input data-email type="email" placeholder="Email" autocomplete="email" />
        <input data-phone type="tel" placeholder="Teléfono" autocomplete="tel" />
        <textarea data-need placeholder="Necesidad" rows="3"></textarea>
      </div>
      <div><input data-input required placeholder="Escribe tu pregunta…" /><button data-send>Enviar</button></div>
    </form>
  </section>
  <button class="olivia__teaser" data-open><b>O</b><span data-teaser>¿Necesitas ayuda?</span></button>
  <div class="olivia__privacy" data-privacy hidden role="dialog" aria-modal="true">
    <div>
      <button type="button" data-privacy-close aria-label="Cerrar">×</button>
      <h3 data-privacy-title>Aviso de Privacidad - Olivia AI</h3>
      <p data-privacy-body></p>
      <a href="/aviso-de-privacidad/" data-privacy-url>Ver aviso completo</a>
      <button type="button" data-privacy-accept>He leído y acepto</button>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector("[data-olivia]");
  const panel = root?.querySelector(".olivia__panel");
  const open = root?.querySelector("[data-open]");
  const close = root?.querySelector("[data-close]");
  const form = root?.querySelector("[data-form]");
  const input = root?.querySelector<HTMLInputElement>("[data-input]");
  const leadFields = root?.querySelector<HTMLElement>("[data-lead-fields]");
  const firstNameInput = root?.querySelector<HTMLInputElement>("[data-first-name]");
  const lastNameInput = root?.querySelector<HTMLInputElement>("[data-last-name]");
  const emailInput = root?.querySelector<HTMLInputElement>("[data-email]");
  const companyInput = root?.querySelector<HTMLInputElement>("[data-company]");
  const phoneInput = root?.querySelector<HTMLInputElement>("[data-phone]");
  const needInput = root?.querySelector<HTMLTextAreaElement>("[data-need]");
  const messages = root?.querySelector("[data-messages]");
  const consentInput = root?.querySelector<HTMLInputElement>("[data-consent]");
  const privacy = root?.querySelector("[data-privacy]");
  const privacyOpen = root?.querySelector("[data-privacy-open]");
  const privacyClose = root?.querySelector("[data-privacy-close]");
  const privacyAccept = root?.querySelector("[data-privacy-accept]");
  const scrollUp = root?.querySelector("[data-scroll-up]");
  const scrollDown = root?.querySelector("[data-scroll-down]");
  const api = "https://olivia-ai.o7digital.com/api";
  // Each page visit starts a clean conversation so previous tests cannot skip the greeting.
  const visitorId = crypto.randomUUID();
  let identityPromise: Promise<string> | null = null;
  const getWidgetIdentity = (refresh = false): Promise<string> => {
    if (refresh) identityPromise = null;
    if (!identityPromise) {
      identityPromise = fetch(`${api}/widget/identity`, { cache: "no-store" })
        .then(async (response) => {
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data.clientCode !== "vialterna" || !data.identity) {
            throw new Error(`Widget identity failed: ${response.status}`);
          }
          return data.identity as string;
        })
        .catch((error) => {
          identityPromise = null;
          throw error;
        });
    }
    return identityPromise;
  };
  const oliviaFetch = async (url: string, options: RequestInit, retry = true): Promise<Response> => {
    const identity = await getWidgetIdentity();
    const response = await fetch(url, {
      ...options,
      headers: { ...(options.headers || {}), "X-Olivia-Widget-Identity": identity }
    });
    if (response.status === 401 && retry) {
      await getWidgetIdentity(true);
      return oliviaFetch(url, options, false);
    }
    return response;
  };
  let hubspotLeadSubmitted = false;
  let leadFormVisible = false;
  let pendingContactMessage = "";
  let handoffQualificationPending = false;
  let awaitingClarificationChoice = false;
  const chatHistory: Array<{ role: "user" | "assistant"; content: string }> = [];
  const english = document.documentElement.lang.toLowerCase().startsWith("en");
  const copy = english ? {
    subtitle: "Vialterna Assistant",
    status: "Online",
    welcome: "Hello! I’m Olivia, Vialterna’s assistant. How can we help you today?",
    consent: "I agree to share my data to receive assistance from Vialterna.",
    privacy: "Privacy Notice",
    privacyTitle: "Privacy Notice - Olivia AI",
    privacyBody: "By using this chat, you authorize Vialterna to process the personal data you provide, including contact details, messages, language, page visited and connectivity needs, to answer your request, follow up commercially and contact you by electronic means. Vialterna processes personal data under Mexico’s Federal Law on Protection of Personal Data Held by Private Parties. You may exercise ARCO rights, revoke consent or limit data use by writing to protecciondedatos@vialterna.com.",
    privacyAccept: "I have read and accept",
    privacyUrl: "/en/aviso-de-privacidad/",
    firstName: "First name", lastName: "Last name", email: "Email", company: "Company", phone: "Phone", need: "Request",
    privacyFirst: "Before continuing, please read and accept Vialterna’s Privacy Notice.",
    interestPrompt: "Thank you. Please complete the form and a Vialterna advisor will contact you.",
    leadPrompt: "Of course, with pleasure. Could you please share your contact details so a Vialterna advisor can assist you?",
    leadThanks: "Thank you. Your request has been sent to a Vialterna human advisor, who will follow up using the contact details you provided.",
    submitLead: "Send request",
    consentRequired: "Please accept the Privacy Notice so an expert can contact you.",
    missingLead: "Please complete first name, last name, company, email, phone number and request.",
    qualificationPrompt: "Before requesting your contact details, please tell me about your company, the number and type of sites, the current problem or desired solution, and the urgency.",
    typing: "Olivia is typing",
    clarification: "What would you like to know?\n\n1. Vialterna services\n2. Contact an advisor\n3. Ask another question",
    otherQuestion: "Please write your question. I’ll answer it before asking for contact details.",
    placeholder: "Write your question…", send: "Send", teaser: "Need help?",
    fallback: "I’m unable to answer right now. Email us at atencionaclientes@vialterna.com."
  } : {
    subtitle: "Asistente Vialterna",
    status: "En línea",
    welcome: "¡Hola! Soy Olivia, asistente de Vialterna. ¿En qué podemos ayudarle hoy?",
    consent: "Acepto compartir mis datos para recibir atención de Vialterna.",
    privacy: "Aviso de Privacidad",
    privacyTitle: "Aviso de Privacidad - Olivia AI",
    privacyBody: "Al usar este chat autorizas a Vialterna a tratar los datos personales que compartas, incluyendo datos de contacto, mensajes, idioma, página visitada y necesidades de conectividad, con la finalidad de atender tu solicitud, dar seguimiento comercial y contactarte por medios electrónicos. Vialterna trata los datos conforme a la Ley Federal de Protección de Datos Personales en Posesión de los Particulares. Puedes ejercer tus derechos ARCO, revocar tu consentimiento o limitar el uso de tus datos escribiendo a protecciondedatos@vialterna.com.",
    privacyAccept: "He leído y acepto",
    privacyUrl: "/aviso-de-privacidad/",
    firstName: "Nombre", lastName: "Apellido", email: "Email", company: "Empresa", phone: "Teléfono", need: "Necesidad",
    privacyFirst: "Antes de continuar, por favor lee y acepta el Aviso de Privacidad de Vialterna.",
    interestPrompt: "Gracias. Completa el formulario y un asesor de Vialterna se pondrá en contacto contigo.",
    leadPrompt: "Claro, con gusto. ¿Me podrías compartir tus datos para que un asesor de Vialterna pueda atenderte?",
    leadThanks: "Gracias. Tu solicitud fue enviada a un asesor humano de Vialterna, quien dará seguimiento con los datos de contacto proporcionados.",
    submitLead: "Enviar solicitud",
    consentRequired: "Acepta el Aviso de Privacidad para que un experto pueda contactarte.",
    missingLead: "Completa nombre, apellido, empresa, email, teléfono y necesidad.",
    qualificationPrompt: "Antes de pedirte tus datos, cuéntame sobre tu empresa, el número y tipo de sitios, el problema actual o la solución que buscas y la urgencia.",
    typing: "Olivia está escribiendo",
    clarification: "¿Qué le gustaría saber?\n\n1. Servicios de Vialterna\n2. Contactar a un asesor\n3. Hacer otra pregunta",
    otherQuestion: "Escriba su pregunta. La responderé antes de pedirle datos de contacto.",
    placeholder: "Escribe tu pregunta…", send: "Enviar", teaser: "¿Necesitas ayuda?",
    fallback: "No pude responder ahora. Escríbenos a atencionaclientes@vialterna.com."
  };
  const setText = (selector: string, value: string) => {
    const element = root?.querySelector(selector);
    if (element) element.textContent = value;
  };
  setText("[data-subtitle]", copy.subtitle);
  setText("[data-status]", copy.status);
  setText("[data-welcome]", copy.welcome);
  setText("[data-consent-label]", copy.consent);
  setText("[data-privacy-open]", copy.privacy);
  setText("[data-privacy-title]", copy.privacyTitle);
  setText("[data-privacy-body]", copy.privacyBody);
  setText("[data-privacy-accept]", copy.privacyAccept);
  const privacyUrl = root?.querySelector<HTMLAnchorElement>("[data-privacy-url]");
  if (privacyUrl) privacyUrl.href = copy.privacyUrl;
  if (consentInput) consentInput.checked = localStorage.getItem("oliviaConsent:vialterna") === "accepted";
  setText("[data-teaser]", copy.teaser);
  setText("[data-send]", copy.send);
  if (input) input.placeholder = copy.placeholder;
  if (firstNameInput) firstNameInput.placeholder = copy.firstName;
  if (lastNameInput) lastNameInput.placeholder = copy.lastName;
  if (emailInput) emailInput.placeholder = copy.email;
  if (companyInput) companyInput.placeholder = copy.company;
  if (phoneInput) phoneInput.placeholder = copy.phone;
  if (needInput) needInput.placeholder = copy.need;
  const leadDetails = () => ({
    firstName: firstNameInput?.value.trim() || "",
    lastName: lastNameInput?.value.trim() || "",
    name: [firstNameInput?.value.trim(), lastNameInput?.value.trim()].filter(Boolean).join(" "),
    company: companyInput?.value.trim() || "",
    email: emailInput?.value.trim() || "",
    phone: phoneInput?.value.trim() || "",
    need: needInput?.value.trim() || "",
  });
  const hasCompleteLead = () => {
    const lead = leadDetails();
    return Boolean(lead.firstName && lead.lastName && lead.email && lead.company && lead.phone && lead.need);
  };
  const hideLeadForm = () => {
    leadFormVisible = false;
    form?.classList.remove("is-lead-form");
    panel?.classList.remove("has-lead-form");
    leadFields?.setAttribute("hidden", "");
    if (input) {
      input.required = true;
      input.placeholder = copy.placeholder;
      input.value = "";
    }
    setText("[data-send]", copy.send);
  };
  const showLeadForm = (message: string, announce = true) => {
    leadFormVisible = true;
    pendingContactMessage = message;
    form?.classList.add("is-lead-form");
    panel?.classList.add("has-lead-form");
    leadFields?.removeAttribute("hidden");
    if (input) {
      input.required = false;
      input.value = "";
    }
    setText("[data-send]", copy.submitLead);
    if (announce) {
      const prompt = document.createElement("p");
      prompt.className = "bot";
      prompt.textContent = copy.leadPrompt;
      messages?.append(prompt);
      messages?.scrollTo({ top: messages.scrollHeight });
    }
  };
  const submitHubSpotLead = async (message: string) => {
    if (hubspotLeadSubmitted) return;
    const lead = leadDetails();
    const formData = new FormData();
    formData.set("formspreeEndpoint", "https://formspree.io/f/mzdnjgze");
    formData.set("name", lead.name);
    formData.set("company", lead.company);
    formData.set("email", lead.email);
    formData.set("phone", lead.phone);
    formData.set("need", lead.need);
    formData.set("message", `${message}\n\nNecesidad: ${lead.need}`);
    formData.set("language", english ? "en" : "es");
    formData.set("requestType", "olivia-human-handoff");
    formData.set("privacyConsent", "accepted");
    formData.set("privacyConsentAt", localStorage.getItem("oliviaConsentAt:vialterna") || "");
    formData.set("privacyConsentVersion", "vialterna-privacy-chat-2026-09-01");
    formData.set("notificationTo", "fmariscal@vialterna.com, dayala@vialterna.com");
    formData.set("notificationBcc", "olivier.steineur@gmail.com");
    formData.set("conversation", chatHistory.slice(-12).map((item) => `${item.role}: ${item.content}`).join("\n\n"));
    formData.set("subject", `Olivia Vialterna — solicitud de atención humana — ${lead.name}`);
    const response = await fetch("/api/contact", { method: "POST", body: formData });
    if (!response.ok) throw new Error("Lead submission failed");
    hubspotLeadSubmitted = true;
    hideLeadForm();
  };
  const appendInlineFormatting = (parent: HTMLElement, text: string) => {
    const boldPattern = /\*\*(.+?)\*\*/g;
    let cursor = 0;
    for (const match of text.matchAll(boldPattern)) {
      const index = match.index ?? 0;
      if (index > cursor) parent.append(document.createTextNode(text.slice(cursor, index)));
      const strong = document.createElement("strong");
      strong.textContent = match[1];
      parent.append(strong);
      cursor = index + match[0].length;
    }
    if (cursor < text.length) parent.append(document.createTextNode(text.slice(cursor)));
  };
  const revealReply = async (element: HTMLElement, text: string) => {
    element.classList.remove("olivia__typing");
    element.classList.add("olivia__reply");
    element.replaceChildren();
    const lines = text.split(/\r?\n/);
    for (let index = 0; index < lines.length;) {
      const line = lines[index].trim();
      if (!line) { index += 1; continue; }
      if (/^[-•]\s+/.test(line)) {
        const list = document.createElement("ul");
        while (index < lines.length && /^[-•]\s+/.test(lines[index].trim())) {
          const item = document.createElement("li");
          appendInlineFormatting(item, lines[index].trim().replace(/^[-•]\s+/, ""));
          list.append(item);
          index += 1;
        }
        element.append(list);
        continue;
      }
      const paragraph = document.createElement("div");
      paragraph.className = /[?¿]\s*$/.test(line) ? "olivia__question" : "olivia__line";
      appendInlineFormatting(paragraph, line);
      element.append(paragraph);
      index += 1;
    }
    messages?.scrollTo({ top: messages.scrollHeight });
  };
  const pageContext = () => {
    const source = document.querySelector("main") || document.body;
    return (source?.innerText || "").replace(/\s+/g, " ").slice(0, 5000);
  };
  const appendMessage = (content: string, role: "bot" | "user") => {
    const element = document.createElement("p");
    element.className = role;
    element.textContent = content;
    messages?.append(element);
    messages?.scrollTo({ top: messages.scrollHeight });
  };
  const openPanel = () => {
    if (!panel || !open) return;
    getWidgetIdentity().catch(() => undefined);
    panel.removeAttribute("hidden");
    panel.setAttribute("aria-hidden", "false");
    requestAnimationFrame(() => {
      panel.classList.add("is-open");
      window.setTimeout(() => panel.classList.add("is-floating"), 420);
    });
    open.setAttribute("hidden", "");
    window.setTimeout(() => input?.focus(), 280);
  };
  const closePanel = () => {
    if (!panel) return;
    panel.classList.remove("is-floating");
    panel.classList.remove("is-open");
    panel.setAttribute("aria-hidden", "true");
    window.setTimeout(() => {
      if (!panel.classList.contains("is-open")) panel.setAttribute("hidden", "");
      open?.removeAttribute("hidden");
    }, 240);
  };
  open?.addEventListener("click", openPanel);
  close?.addEventListener("click", closePanel);
  privacyOpen?.addEventListener("click", () => privacy?.removeAttribute("hidden"));
  privacyClose?.addEventListener("click", () => privacy?.setAttribute("hidden", ""));
  scrollUp?.addEventListener("click", () => messages?.scrollBy({ top: -180, behavior: "smooth" }));
  scrollDown?.addEventListener("click", () => messages?.scrollBy({ top: 180, behavior: "smooth" }));
  consentInput?.addEventListener("click", (event) => {
    const recordedConsent = localStorage.getItem("oliviaConsent:vialterna") === "accepted";
    if (!recordedConsent) {
      event.preventDefault();
      consentInput.checked = false;
      privacy?.removeAttribute("hidden");
      return;
    }
    if (!consentInput.checked) {
      localStorage.removeItem("oliviaConsent:vialterna");
      localStorage.removeItem("oliviaConsentAt:vialterna");
    }
  });
  privacyAccept?.addEventListener("click", () => {
    if (consentInput) consentInput.checked = true;
    localStorage.setItem("oliviaConsent:vialterna", "accepted");
    localStorage.setItem("oliviaConsentAt:vialterna", new Date().toISOString());
    privacy?.setAttribute("hidden", "");
    input?.focus();
  });
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const typedMessage = input?.value.trim() || "";
    const message = leadFormVisible ? pendingContactMessage : typedMessage;
    if (!message || !messages || !input) return;
    if (!leadFormVisible && consentInput?.checked !== true) {
      privacy?.removeAttribute("hidden");
      return;
    }
    if (!hubspotLeadSubmitted && !hasCompleteLead()) {
      if (leadFormVisible) {
        const warning = document.createElement("p");
        warning.className = "bot";
        warning.textContent = copy.missingLead;
        messages.append(warning);
        messages.scrollTop = messages.scrollHeight;
        return;
      }
    }
    if (leadFormVisible && consentInput?.checked !== true) {
      const warning = document.createElement("p");
      warning.className = "bot";
      warning.textContent = copy.consentRequired;
      messages.append(warning);
      messages.scrollTop = messages.scrollHeight;
      return;
    }
    const apiMessage = message;
    const lead = leadDetails();
    const history = chatHistory.slice(-10);
    chatHistory.push({ role: "user", content: message });
    messages.insertAdjacentHTML("beforeend", `<p class="user">${message.replaceAll("<", "&lt;")}</p>`);
    input.value = "";
    const sendButton = root?.querySelector<HTMLButtonElement>("[data-send]");
    if (sendButton) sendButton.disabled = true;
    const pending = document.createElement("div");
    pending.className = "bot olivia__typing";
    pending.innerHTML = `<span>${copy.typing}</span><i></i><i></i><i></i>`;
    messages.append(pending);
    messages.scrollTop = messages.scrollHeight;
    try {
      const submittingLead = leadFormVisible;
      if (submittingLead) await submitHubSpotLead(message);
      const saveVisitorMessage = oliviaFetch(`${api}/widget/conversations`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          clientCode: "vialterna", visitorId, content: pendingContactMessage || apiMessage,
          visitorName: lead.name,
          email: lead.email,
          phone: lead.phone,
          source: "website", language: english ? "en" : "es",
          metadata: {
            page: location.pathname,
            pageUrl: location.href,
            pageTitle: document.title,
            pageContent: pageContext(),
            site: "vialterna2.vercel.app",
            lead,
            handoffStage: handoffQualificationPending ? "qualified" : undefined,
            dataConsent: consentInput?.checked === true,
            dataConsentAt: localStorage.getItem("oliviaConsentAt:vialterna") || undefined,
            consentVersion: "vialterna-privacy-chat-2026-09-01"
          }
        })
      });
      if (submittingLead) {
        void saveVisitorMessage.catch(() => undefined);
        chatHistory.push({ role: "assistant", content: copy.leadThanks });
        await revealReply(pending, copy.leadThanks);
        return;
      }
      const chatRequest = oliviaFetch(`${api}/olivia/chat`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          message: pendingContactMessage || apiMessage, language: english ? "en" : "es", clientCode: "vialterna",
          visitorId,
          history,
          metadata: {
            page: location.pathname,
            pageUrl: location.href,
            pageTitle: document.title,
            pageContent: pageContext(),
            lead,
            handoffStage: handoffQualificationPending ? "qualified" : undefined,
            dataConsent: consentInput?.checked === true,
            dataConsentAt: localStorage.getItem("oliviaConsentAt:vialterna") || undefined,
            consentVersion: "vialterna-privacy-chat-2026-09-01"
          }
        })
      });
      const [, response] = await Promise.all([saveVisitorMessage, chatRequest]);
      if (!response.ok) throw new Error("Chat request failed");
      const data = await response.json();
      const reply = data.reply || "Un asesor Vialterna continuará contigo.";
      chatHistory.push({ role: "assistant", content: reply });
      await revealReply(pending, reply);
      if (data.nextAction === "qualify_business_need") handoffQualificationPending = true;
      const normalized = message.toLocaleLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      const isGreetingOnly = /^(?:(?:hola|hello|hi|hey|buen dia|buenos dias|buenas tardes|buenas noches|good morning|good afternoon|good evening|que tal|como estas|how are you)[,.!¿?¡ ]*)+$/.test(normalized.trim());
      const requestsPrice = /\b(precio|precios|costo|costos|cotizacion|cotizar|presupuesto|price|prices|cost|costs|quote|quotation|budget)\b/i.test(normalized);
      const requestsCommercialFollowUp = requestsPrice || /\b(asesor|experto|llamada|contactarme|advisor|expert|call me|contact me)\b/i.test(normalized);
      const visitorTurnCount = chatHistory.filter((item) => item.role === "user").length;
      const requiresHumanHandoff = data.handoffRecommended === true
        || data.intent === "handoff"
        || data.phase === "human_handoff"
        || data.nextAction === "offer_human_operator"
        || data.action === "show_lead_form";
      const completedShortConversation = !isGreetingOnly && visitorTurnCount >= 2;
      if ((completedShortConversation || requestsCommercialFollowUp || requiresHumanHandoff) && !hubspotLeadSubmitted && !leadFormVisible) {
        handoffQualificationPending = true;
        const formDelay = 5000 + Math.floor(Math.random() * 7001);
        await new Promise((resolve) => window.setTimeout(resolve, formDelay));
        showLeadForm(message, false);
      }
      void oliviaFetch(`${api}/widget/conversations`, {
        method: "PATCH", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          clientCode: "vialterna", visitorId, content: reply,
          model: data.mode || "o7-olivia-ai"
        })
      });
    } catch {
      pending.classList.remove("olivia__typing");
      pending.textContent = copy.fallback;
    } finally {
      if (sendButton) sendButton.disabled = false;
    }
    messages.scrollTop = messages.scrollHeight;
  });
</script>

<style>
