<div class="olivia" data-olivia>
  <section class="olivia__panel" hidden>
    <header>
      <div><strong>Olivia</strong><small data-subtitle>Asistente Vialterna</small></div>
      <span class="olivia__status"><i aria-hidden="true"></i><span data-status>En línea</span></span>
      <button class="olivia__close" data-close aria-label="Cerrar">×</button>
    </header>
    <div class="olivia__messages" data-messages aria-live="polite">
      <p class="bot" data-welcome>Hola, soy Olivia. Cuéntame qué está pasando y te ayudaré a precisar la necesidad. Si hace falta, te pondré en contacto con un especialista con el contexto listo.</p>
      <div class="olivia__actions" data-actions></div>
    </div>
    <form data-form>
      <label><input type="checkbox" data-consent /> <span><span data-consent-label>Acepto compartir mis datos para recibir atención de Vialterna.</span> <button type="button" class="olivia__privacy-link" data-privacy-open>Aviso de Privacidad</button></span></label>
      <div><input data-input required placeholder="Escribe tu pregunta…" /><button data-send>Enviar</button></div>
    </form>
  </section>
  <button class="olivia__teaser" data-open><b>O</b><span data-teaser>Hablar con Olivia</span></button>
  <button class="olivia__toggle" data-toggle aria-label="Abrir chat">Olivia</button>
  <div class="olivia__privacy" data-privacy hidden role="dialog" aria-modal="true">
    <div>
      <button type="button" data-privacy-close aria-label="Cerrar">×</button>
      <h3 data-privacy-title>Aviso de Privacidad - Olivia AI</h3>
      <p data-privacy-body></p>
      <a href="/aviso-de-privacidad/" data-privacy-url>Ver aviso completo</a>
      <button type="button" data-privacy-accept>He leído y acepto</button>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector("[data-olivia]");
  const panel = root?.querySelector(".olivia__panel");
  const open = root?.querySelector("[data-open]");
  const toggle = root?.querySelector<HTMLButtonElement>("[data-toggle]");
  const close = root?.querySelector("[data-close]");
  const form = root?.querySelector("[data-form]");
  const input = root?.querySelector<HTMLInputElement>("[data-input]");
  const messages = root?.querySelector("[data-messages]");
  const consentInput = root?.querySelector<HTMLInputElement>("[data-consent]");
  const privacy = root?.querySelector("[data-privacy]");
  const privacyOpen = root?.querySelector("[data-privacy-open]");
  const privacyClose = root?.querySelector("[data-privacy-close]");
  const privacyAccept = root?.querySelector("[data-privacy-accept]");
  const api = "https://olivia-ai.o7digital.com/api";
  const visitorId = localStorage.getItem("vialterna-visitor-id") || crypto.randomUUID();
  localStorage.setItem("vialterna-visitor-id", visitorId);
  const chatTranscript: string[] = [];
  let syncedLeadEmail = "";
  const vialternaPhone = "525580626884";

  // Every request to the Olivia backend must carry a signed widget identity bound to this site's origin.
  let identityPromise: Promise<string> | null = null;
  const getIdentity = (refresh: boolean): Promise<string> => {
    if (refresh) identityPromise = null;
    if (!identityPromise) {
      identityPromise = fetch(`${api}/widget/identity`, { cache: "no-store" })
        .then(async (response) => {
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data.clientCode !== "vialterna" || !data.identity) {
            throw new Error(`Identity ${response.status}`);
          }
          return data.identity as string;
        })
        .catch((error) => {
          identityPromise = null;
          throw error;
        });
    }
    return identityPromise;
  };
  const oliviaFetch = async (url: string, options: RequestInit, retry = true): Promise<Response> => {
    const identity = await getIdentity(false);
    const response = await fetch(url, {
      ...options,
      headers: { ...(options.headers || {}), "X-Olivia-Widget-Identity": identity },
    });
    if (response.status === 401 && retry) {
      await getIdentity(true);
      return oliviaFetch(url, options, false);
    }
    return response;
  };
  const syncLeadToHubSpot = async (data: any) => {
    const collected = data?.collected || {};
    const email = typeof collected.email === "string" ? collected.email.trim().toLowerCase() : "";
    const name = typeof collected.name === "string" ? collected.name.trim() : "";
    if (!email || !name || email === syncedLeadEmail || consentInput?.checked !== true) return;

    const response = await fetch("/api/olivia-lead", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name,
        email,
        phone: collected.phone || "",
        company: data?.leadForm?.company || "",
        language: english ? "en" : "es",
        visitorId,
        transcript: chatTranscript.slice(-12).join("\n"),
        consent: true
      })
    });
    if (!response.ok) throw new Error(`HubSpot lead sync failed: ${response.status}`);
    syncedLeadEmail = email;
  };
  const english = document.documentElement.lang.toLowerCase().startsWith("en");
  const copy = english ? {
    subtitle: "Vialterna Assistant", status: "Online", open: "Open chat", close: "Close chat",
    welcome: "Hello, I’m Olivia. Tell me what is happening and I’ll help clarify the need. If necessary, I’ll connect you with a specialist with the context ready.",
    consent: "I agree to share my data to receive assistance from Vialterna.",
    privacy: "Privacy Notice",
    privacyTitle: "Privacy Notice - Olivia AI",
    privacyBody: "By using this chat, you authorize Vialterna to process the personal data you provide, including contact details, messages, language, page visited and connectivity needs, to answer your request, follow up commercially and contact you by electronic means. Vialterna processes personal data under Mexico’s Federal Law on Protection of Personal Data Held by Private Parties. You may exercise ARCO rights, revoke consent or limit data use by writing to protecciondedatos@vialterna.com.",
    privacyAccept: "I have read and accept",
    privacyUrl: "/en/aviso-de-privacidad/",
    placeholder: "Describe your need…", send: "Send", teaser: "Talk to Olivia",
    fallback: "I’m unable to answer right now. Email us at atencionaclientes@vialterna.com.",
    whatsapp: "Continue on WhatsApp",
    email: "Send by email",
    handoff: "Choose how you would like to continue with a Vialterna specialist. I’ll include the context from this conversation.",
    handoffSubject: "Vialterna inquiry via Olivia",
    consentNeeded: "To send your question to Olivia, please accept the privacy notice first. I’ll only request contact details if you choose to speak with an agent."
  } : {
    subtitle: "Asistente Vialterna", status: "En línea", open: "Abrir chat", close: "Cerrar chat",
    welcome: "Hola, soy Olivia. Cuéntame qué está pasando y te ayudaré a precisar la necesidad. Si hace falta, te pondré en contacto con un especialista con el contexto listo.",
    consent: "Acepto compartir mis datos para recibir atención de Vialterna.",
    privacy: "Aviso de Privacidad",
    privacyTitle: "Aviso de Privacidad - Olivia AI",
    privacyBody: "Al usar este chat autorizas a Vialterna a tratar los datos personales que compartas, incluyendo datos de contacto, mensajes, idioma, página visitada y necesidades de conectividad, con la finalidad de atender tu solicitud, dar seguimiento comercial y contactarte por medios electrónicos. Vialterna trata los datos conforme a la Ley Federal de Protección de Datos Personales en Posesión de los Particulares. Puedes ejercer tus derechos ARCO, revocar tu consentimiento o limitar el uso de tus datos escribiendo a protecciondedatos@vialterna.com.",
    privacyAccept: "He leído y acepto",
    privacyUrl: "/aviso-de-privacidad/",
    placeholder: "Describe tu necesidad…", send: "Enviar", teaser: "Hablar con Olivia",
    fallback: "No pude responder ahora. Escríbenos a atencionaclientes@vialterna.com.",
    whatsapp: "Continuar por WhatsApp",
    email: "Enviar por correo",
    handoff: "Elige cómo quieres continuar con un especialista de Vialterna. Incluiré el contexto de esta conversación.",
    handoffSubject: "Consulta Vialterna desde Olivia",
    consentNeeded: "Para enviar tu pregunta a Olivia, acepta primero el aviso de privacidad. Solo te pediré datos de contacto si eliges hablar con un agente."
  };
  const setText = (selector: string, value: string) => {
    const element = root?.querySelector(selector);
    if (element) element.textContent = value;
  };
  setText("[data-subtitle]", copy.subtitle);
  setText("[data-status]", copy.status);
  setText("[data-welcome]", copy.welcome);
  setText("[data-consent-label]", copy.consent);
  setText("[data-privacy-open]", copy.privacy);
  setText("[data-privacy-title]", copy.privacyTitle);
  setText("[data-privacy-body]", copy.privacyBody);
  setText("[data-privacy-accept]", copy.privacyAccept);
  const privacyUrl = root?.querySelector<HTMLAnchorElement>("[data-privacy-url]");
  if (privacyUrl) privacyUrl.href = copy.privacyUrl;
  setText("[data-teaser]", copy.teaser);
  setText("[data-send]", copy.send);
  if (input) input.placeholder = copy.placeholder;
  if (consentInput && localStorage.getItem("oliviaConsent:vialterna") === "accepted") consentInput.checked = true;
  const actions = root?.querySelector<HTMLElement>("[data-actions]");
  const addMessage = (content: string, className: "bot" | "user" = "bot") => {
    if (!messages) return;
    const message = document.createElement("p");
    message.className = className;
    message.textContent = content;
    messages.append(message);
    messages.scrollTop = messages.scrollHeight;
  };
  const showHandoffActions = () => {
    if (!actions) return;
    actions.replaceChildren();
    addMessage(copy.handoff);
    const summary = chatTranscript.slice(-10).join("\n");
    const body = `${copy.handoffSubject}\n\n${summary}`;
    const whatsapp = document.createElement("a");
    whatsapp.href = `https://wa.me/${vialternaPhone}?text=${encodeURIComponent(body)}`;
    whatsapp.target = "_blank";
    whatsapp.rel = "noopener noreferrer";
    whatsapp.textContent = copy.whatsapp;
    const email = document.createElement("a");
    email.href = `mailto:atencionaclientes@vialterna.com?subject=${encodeURIComponent(copy.handoffSubject)}&body=${encodeURIComponent(body)}`;
    email.textContent = copy.email;
    actions.append(whatsapp, email);
    messages?.append(actions);
    messages && (messages.scrollTop = messages.scrollHeight);
  };
  const setOpen = (isOpen: boolean) => {
    panel?.toggleAttribute("hidden", !isOpen);
    open?.toggleAttribute("hidden", isOpen);
    if (toggle) {
      toggle.textContent = isOpen ? "×" : "Olivia";
      toggle.setAttribute("aria-label", isOpen ? copy.close : copy.open);
    }
    if (isOpen) input?.focus();
  };
  open?.addEventListener("click", () => setOpen(true));
  close?.addEventListener("click", () => setOpen(false));
  toggle?.addEventListener("click", () => setOpen(panel?.hasAttribute("hidden") === true));
  privacyOpen?.addEventListener("click", () => privacy?.removeAttribute("hidden"));
  privacyClose?.addEventListener("click", () => privacy?.setAttribute("hidden", ""));
  privacyAccept?.addEventListener("click", () => {
    if (consentInput) consentInput.checked = true;
    localStorage.setItem("oliviaConsent:vialterna", "accepted");
    localStorage.setItem("oliviaConsentAt:vialterna", new Date().toISOString());
    privacy?.setAttribute("hidden", "");
  });
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const message = input?.value.trim();
    if (!message || !messages || !input) return;
    addMessage(message, "user");
    input.value = "";
    if (consentInput?.checked !== true) {
      addMessage(copy.consentNeeded);
      return;
    }
    chatTranscript.push(`Visitor: ${message}`);
    const pending = document.createElement("p"); pending.className = "bot"; pending.textContent = "…"; messages.append(pending);
    try {
      await oliviaFetch(`${api}/widget/conversations`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          clientCode: "vialterna", visitorId, content: message,
          source: "website", language: english ? "en" : "es",
          metadata: {
            page: location.pathname,
            pageUrl: location.href,
            pageTitle: document.title,
            pageContent: document.body.innerText.replace(/\s+/g, " ").slice(0, 5000),
            site: "vialterna.com",
            dataConsent: consentInput?.checked === true,
            consentVersion: "vialterna-privacy-chat-2026-07-01"
          }
        })
      });
      const response = await oliviaFetch(`${api}/olivia/chat`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          message, language: english ? "en" : "es", clientCode: "vialterna",
          visitorId,
          metadata: {
            page: location.pathname,
            pageUrl: location.href,
            pageTitle: document.title,
            pageContent: document.body.innerText.replace(/\s+/g, " ").slice(0, 5000)
          }
        })
      });
      if (!response.ok) throw new Error("Chat request failed");
      const data = await response.json();
      pending.textContent = data.reply || "Un asesor Vialterna continuará contigo.";
      chatTranscript.push(`Olivia: ${pending.textContent}`);
      syncLeadToHubSpot(data).catch((error) => console.error(error));
      if (data.handoffRecommended === true || data.intent === "handoff" || data.nextAction === "offer_human_operator") {
        showHandoffActions();
      }
      await oliviaFetch(`${api}/widget/conversations`, {
        method: "PATCH", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          clientCode: "vialterna", visitorId, content: pending.textContent,
          model: data.mode || "o7-olivia-ai"
        })
      });
    } catch { pending.textContent = copy.fallback; }
    messages.scrollTop = messages.scrollHeight;
  });
</script>

<style>
  .olivia{position:fixed;right:24px;bottom:24px;z-index:9999;font:14px/1.4 Inter,sans-serif}.olivia__teaser{display:flex;align-items:center;gap:10px;padding:10px 15px;border:1px solid #28d7c0;border-radius:999px;background:#071d2b;color:#fff;box-shadow:0 14px 38px #0005}.olivia__teaser b{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#28d7c0;color:#071d2b}.olivia__panel{width:min(380px,calc(100vw - 28px));overflow:hidden;border:1px solid #28d7c066;border-radius:16px;background:#071d2b;color:#fff;box-shadow:0 20px 60px #0007}.olivia__panel header{display:flex;justify-content:space-between;padding:16px;background:#0b2c3d}.olivia__panel small{display:block;color:#9bc7cf}.olivia__panel button{border:0;border-radius:8px;background:#28d7c0;color:#071d2b;font-weight:700}.olivia__messages{height:290px;overflow:auto;padding:14px;background:#f4f8f9;color:#122}.olivia__messages p{max-width:85%;padding:9px 11px;border-radius:12px;background:#fff}.olivia__messages .user{margin-left:auto;background:#d8faf5}.olivia__actions{display:grid;gap:7px;margin:10px 0}.olivia__actions button,.olivia__actions a{display:block;width:100%;box-sizing:border-box;padding:9px 11px;border:1px solid #0b7180;border-radius:9px;background:#fff;color:#075565;text-align:left;text-decoration:none;cursor:pointer}.olivia__actions button:hover,.olivia__actions a:hover{background:#d8faf5}.olivia form{padding:12px}.olivia label{display:flex;gap:7px;font-size:11px;color:#c5d7dc}.olivia__privacy-link{border:0!important;background:transparent!important;color:#28d7c0!important;text-decoration:underline;padding:0!important;font:inherit!important}.olivia form div{display:flex;gap:8px;margin-top:10px}.olivia form input[data-input]{min-width:0;flex:1;padding:11px;border:0;border-radius:8px}.olivia__privacy{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;background:#0008;padding:18px}.olivia__privacy[hidden]{display:none}.olivia__privacy>div{position:relative;max-width:560px;border:1px solid #28d7c0;border-radius:18px;background:#f4f8f9;color:#122;padding:24px;box-shadow:0 24px 70px #0008}.olivia__privacy h3{margin:0 0 12px}.olivia__privacy p{font-size:14px;line-height:1.55}.olivia__privacy a{display:inline-block;margin-right:12px;color:#0b7180}.olivia__privacy button{border:0;border-radius:10px;background:#071d2b;color:#fff;padding:10px 14px}.olivia__privacy button:first-child{position:absolute;right:12px;top:10px;background:transparent;color:#071d2b;font-size:22px;padding:0}@media(max-width:560px){.olivia{right:14px;bottom:14px}}
<style>
  .olivia{--accent:#28d7c0;--ink:#071d2b;position:fixed;right:24px;bottom:18px;z-index:9999;width:min(380px,calc(100vw - 28px));font:14px/1.4 "Helvetica Neue",sans-serif;color:#fff}
  .olivia [hidden]{display:none!important}
  .olivia__panel{display:flex;flex-direction:column;max-height:min(620px,calc(100vh - 110px));overflow:hidden;border:1px solid #28d7c080;border-radius:16px;background:#101719;box-shadow:0 42px 72px -24px #000b,0 8px 18px -14px #28d7c066,inset 0 1px #ffffff1f;animation:olivia-float 5.5s ease-in-out infinite}
  @keyframes olivia-float{0%,100%{transform:translateY(-5px)}50%{transform:translateY(-10px)}}
  .olivia__panel header{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:10px;padding:16px;background:linear-gradient(135deg,#071d2bfa,#0b3b42f5);border-bottom:1px solid #28d7c059}
  .olivia__panel strong{display:block;color:var(--accent);font-size:18px;line-height:1.2;text-transform:uppercase}
  .olivia__panel small{display:block;color:#ffffffb8;font-size:12px}
  .olivia__status{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid #ffffff24;border-radius:999px;background:#ffffff12;color:#ffffffb8;font-size:12px;white-space:nowrap}
  .olivia__status i{width:9px;height:9px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px #22c55e24,0 0 14px #22c55ecc}
  .olivia button{border:0;cursor:pointer;font:inherit}
  .olivia__close{width:30px;height:30px;border-radius:50%;background:var(--accent);color:var(--ink);font-weight:900}
  .olivia__messages{height:290px;overflow:auto;padding:16px;background:#171d1f;color:#fff}
  .olivia__messages p{width:fit-content;max-width:88%;margin:0 0 10px;padding:10px 12px;border-radius:18px 18px 18px 6px;background:#293234;color:#fff;box-shadow:0 8px 18px #0003}
  .olivia__messages .user{margin-left:auto;border-radius:18px 18px 6px 18px;background:var(--accent);color:var(--ink)}
  .olivia__actions{display:grid;gap:8px;margin:10px 0}
  .olivia__actions a{display:block;padding:11px 13px;border:1px solid #28d7c080;border-radius:14px;background:#0e292e;color:var(--accent);font-weight:700;text-decoration:none}
  .olivia__actions a:hover{background:#153b40}
  .olivia form{padding:12px;background:#0d1416;border-top:1px solid #ffffff1a}
  .olivia label{display:flex;align-items:flex-start;gap:8px;color:#ffffffbf;font-size:11px;line-height:1.35}
  .olivia label input{accent-color:var(--accent)}
  .olivia__privacy-link{padding:0!important;background:transparent!important;color:var(--accent)!important;text-decoration:underline}
  .olivia form>div{display:grid;grid-template-columns:1fr 48px;gap:8px;margin-top:10px}
  .olivia form input[data-input]{width:100%;min-width:0;box-sizing:border-box;padding:12px;border:1px solid #28d7c059;border-radius:14px;background:#fff;color:#111;font:inherit;outline:none}
  .olivia form button[data-send]{border-radius:50%;background:var(--accent);color:var(--ink);font-size:0;font-weight:900}
  .olivia form button[data-send]::after{content:"→";font-size:20px}
  .olivia__teaser{display:flex;align-items:center;gap:10px;margin:10px 0 0 auto;padding:10px 14px;border:1px solid #28d7c08c;border-radius:999px;background:#101719;color:#fff;box-shadow:0 24px 42px -18px #0009,inset 0 1px #ffffff1a}
  .olivia__teaser b{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--accent);color:var(--ink);font-weight:900}
  .olivia__toggle{display:block;min-width:62px;height:62px;margin:10px 0 0 auto;border-radius:50%;background:var(--accent);color:var(--ink);font-weight:900;box-shadow:0 22px 38px -16px #000a,inset 0 1px #ffffff33}
  .olivia__privacy{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;padding:18px;background:#000b}
  .olivia__privacy>div{position:relative;max-width:560px;padding:24px;border:1px solid #28d7c099;background:#101719;color:#fff;box-shadow:0 24px 70px #0009}
  .olivia__privacy h3{margin:0 32px 12px 0;color:var(--accent)}
  .olivia__privacy p{color:#ffffffcc;line-height:1.55}
  .olivia__privacy a,.olivia__privacy [data-privacy-accept]{display:inline-block;margin:8px 10px 0 0;padding:10px 14px;border:0;background:var(--accent);color:var(--ink);font-weight:800;text-decoration:none}
  .olivia__privacy [data-privacy-close]{position:absolute;top:12px;right:12px;width:30px;height:30px;border-radius:50%;background:var(--accent);font-weight:900}
  @media(max-width:600px){.olivia{right:14px;bottom:14px}.olivia__panel{max-height:calc(100vh - 96px)}.olivia__messages{height:260px}.olivia__status{padding:6px 8px}.olivia__panel header{padding:13px}}
  @media(prefers-reduced-motion:reduce){.olivia__panel{animation:none}}
</style>
