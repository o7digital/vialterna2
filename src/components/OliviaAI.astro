<div class="olivia" data-olivia>
  <section class="olivia__panel" hidden aria-hidden="true">
    <header>
      <div>
        <strong>Olivia</strong>
        <small data-subtitle>Asistente Vialterna · En línea</small>
      </div>
      <span class="olivia__status"><i></i><b data-status>En línea</b></span>
      <button data-close aria-label="Cerrar">×</button>
    </header>
    <div class="olivia__messages" data-messages>
      <p class="bot" data-welcome>Hola, soy Olivia. ¿Cómo puedo ayudarte con la conectividad de tu empresa?</p>
      <button type="button" class="olivia__quick-action" data-services-open>Ver servicios</button>
    </div>
    <form data-form>
      <label><input type="checkbox" data-consent /> <span><span data-consent-label>Acepto compartir mis datos para recibir atención de Vialterna.</span> <button type="button" class="olivia__privacy-link" data-privacy-open>Aviso de Privacidad</button></span></label>
      <div class="olivia__lead-fields" data-lead-fields hidden>
        <input data-name placeholder="Nombre" autocomplete="name" />
        <input data-company placeholder="Empresa" autocomplete="organization" />
        <input data-email type="email" placeholder="Email" autocomplete="email" />
        <input data-phone type="tel" placeholder="Teléfono" autocomplete="tel" />
        <textarea data-details rows="3" placeholder="Detalles de la solicitud"></textarea>
      </div>
      <div><input data-input required placeholder="Escribe tu pregunta…" /><button data-send>Enviar</button></div>
    </form>
  </section>
  <button class="olivia__teaser" data-open><b>O</b><span data-teaser>¿Necesitas ayuda?</span></button>
  <div class="olivia__privacy" data-privacy hidden role="dialog" aria-modal="true">
    <div>
      <button type="button" data-privacy-close aria-label="Cerrar">×</button>
      <h3 data-privacy-title>Aviso de Privacidad - Olivia AI</h3>
      <p data-privacy-body></p>
      <a href="/aviso-de-privacidad/" data-privacy-url>Ver aviso completo</a>
      <button type="button" data-privacy-accept>He leído y acepto</button>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector("[data-olivia]");
  const panel = root?.querySelector(".olivia__panel");
  const open = root?.querySelector("[data-open]");
  const close = root?.querySelector("[data-close]");
  const form = root?.querySelector("[data-form]");
  const input = root?.querySelector<HTMLInputElement>("[data-input]");
  const leadFields = root?.querySelector<HTMLElement>("[data-lead-fields]");
  const nameInput = root?.querySelector<HTMLInputElement>("[data-name]");
  const companyInput = root?.querySelector<HTMLInputElement>("[data-company]");
  const emailInput = root?.querySelector<HTMLInputElement>("[data-email]");
  const phoneInput = root?.querySelector<HTMLInputElement>("[data-phone]");
  const detailsInput = root?.querySelector<HTMLTextAreaElement>("[data-details]");
  const messages = root?.querySelector("[data-messages]");
  const consentInput = root?.querySelector<HTMLInputElement>("[data-consent]");
  const privacy = root?.querySelector("[data-privacy]");
  const privacyOpen = root?.querySelector("[data-privacy-open]");
  const privacyClose = root?.querySelector("[data-privacy-close]");
  const privacyAccept = root?.querySelector("[data-privacy-accept]");
  const api = "https://suitesmine-bot.vercel.app/api";
  const visitorId = localStorage.getItem("vialterna-visitor-id") || crypto.randomUUID();
  localStorage.setItem("vialterna-visitor-id", visitorId);
  let hubspotLeadSubmitted = false;
  let leadFormVisible = false;
  const english = document.documentElement.lang.toLowerCase().startsWith("en");
  const copy = english ? {
    subtitle: "Vialterna Assistant",
    status: "Online",
    welcome: "Hello, I’m Olivia. How can I help with your company’s connectivity?",
    consent: "I agree to share my data to receive assistance from Vialterna.",
    privacy: "Privacy Notice",
    privacyTitle: "Privacy Notice - Olivia AI",
    privacyBody: "By using this chat, you authorize Vialterna to process the personal data you provide, including contact details, messages, language, page visited and connectivity needs, to answer your request, follow up commercially and contact you by electronic means. Vialterna processes personal data under Mexico’s Federal Law on Protection of Personal Data Held by Private Parties. You may exercise ARCO rights, revoke consent or limit data use by writing to protecciondedatos@vialterna.com.",
    privacyAccept: "I have read and accept",
    privacyUrl: "/en/aviso-de-privacidad/",
    name: "Name", company: "Company", email: "Email", phone: "Phone",
    details: "Request info details",
    servicesAction: "View services",
    servicesTitle: "Vialterna services",
    servicesIntro: "These are the main Vialterna solutions:",
    leadPrompt: "Please leave your details and request information so a Vialterna expert can follow up.",
    consentRequired: "Please accept the Privacy Notice so an expert can contact you.",
    missingLead: "Please complete name, company, email, phone and request info details.",
    placeholder: "Write your question…", send: "Send", teaser: "Need help?",
    fallback: "I’m unable to answer right now. Email us at atencionaclientes@vialterna.com."
  } : {
    subtitle: "Asistente Vialterna",
    status: "En línea",
    welcome: "Hola, soy Olivia. ¿Cómo puedo ayudarte con la conectividad de tu empresa?",
    consent: "Acepto compartir mis datos para recibir atención de Vialterna.",
    privacy: "Aviso de Privacidad",
    privacyTitle: "Aviso de Privacidad - Olivia AI",
    privacyBody: "Al usar este chat autorizas a Vialterna a tratar los datos personales que compartas, incluyendo datos de contacto, mensajes, idioma, página visitada y necesidades de conectividad, con la finalidad de atender tu solicitud, dar seguimiento comercial y contactarte por medios electrónicos. Vialterna trata los datos conforme a la Ley Federal de Protección de Datos Personales en Posesión de los Particulares. Puedes ejercer tus derechos ARCO, revocar tu consentimiento o limitar el uso de tus datos escribiendo a protecciondedatos@vialterna.com.",
    privacyAccept: "He leído y acepto",
    privacyUrl: "/aviso-de-privacidad/",
    name: "Nombre", company: "Empresa", email: "Email", phone: "Teléfono",
    details: "Detalles de la solicitud",
    servicesAction: "Ver servicios",
    servicesTitle: "Servicios Vialterna",
    servicesIntro: "Estas son las principales soluciones de Vialterna:",
    leadPrompt: "Déjanos tus datos y los detalles de la solicitud para que un experto Vialterna pueda dar seguimiento.",
    consentRequired: "Acepta el Aviso de Privacidad para que un experto pueda contactarte.",
    missingLead: "Completa nombre, empresa, email, teléfono y detalles de la solicitud.",
    placeholder: "Escribe tu pregunta…", send: "Enviar", teaser: "¿Necesitas ayuda?",
    fallback: "No pude responder ahora. Escríbenos a atencionaclientes@vialterna.com."
  };
  const setText = (selector: string, value: string) => {
    const element = root?.querySelector(selector);
    if (element) element.textContent = value;
  };
  setText("[data-subtitle]", copy.subtitle);
  setText("[data-status]", copy.status);
  setText("[data-welcome]", copy.welcome);
  setText("[data-consent-label]", copy.consent);
  setText("[data-privacy-open]", copy.privacy);
  setText("[data-privacy-title]", copy.privacyTitle);
  setText("[data-privacy-body]", copy.privacyBody);
  setText("[data-privacy-accept]", copy.privacyAccept);
  const privacyUrl = root?.querySelector<HTMLAnchorElement>("[data-privacy-url]");
  if (privacyUrl) privacyUrl.href = copy.privacyUrl;
  setText("[data-teaser]", copy.teaser);
  setText("[data-services-open]", copy.servicesAction);
  setText("[data-send]", copy.send);
  if (input) input.placeholder = copy.placeholder;
  if (nameInput) nameInput.placeholder = copy.name;
  if (companyInput) companyInput.placeholder = copy.company;
  if (emailInput) emailInput.placeholder = copy.email;
  if (phoneInput) phoneInput.placeholder = copy.phone;
  if (detailsInput) detailsInput.placeholder = copy.details;
  const leadDetails = () => ({
    name: nameInput?.value.trim() || "",
    company: companyInput?.value.trim() || "",
    email: emailInput?.value.trim() || "",
    phone: phoneInput?.value.trim() || "",
    details: detailsInput?.value.trim() || ""
  });
  const hasCompleteLead = () => {
    const lead = leadDetails();
    return Boolean(lead.name && lead.company && lead.email && lead.phone && lead.details);
  };
  const serviceLinks = () => english ? [
    { title: "Edge / SuperWAN", text: "Resilient site connectivity with automatic failover and 24/7 monitoring.", href: "/en/solutions/edge/" },
    { title: "Core", text: "Central SD-WAN governance, SLA visibility and multi-carrier orchestration.", href: "/en/solutions/core/" },
    { title: "Telco as a Service", text: "Telecom audit, cost optimization and continuous supplier governance.", href: "/en/solutions/telco-as-a-service/" },
    { title: "IoT and SIM", text: "Managed SIM/eSIM, IoT connectivity and sensor lifecycle control.", href: "/en/solutions/iot-sim/" }
  ] : [
    { title: "Edge / SuperWAN", text: "Conectividad resiliente por sitio con failover automático y monitoreo 24/7.", href: "/soluciones/edge/" },
    { title: "Core", text: "Gobierno SD-WAN central, visibilidad SLA y orquestación multioperador.", href: "/soluciones/core/" },
    { title: "Telco as a Service", text: "Auditoría Telco, optimización de costos y gobierno continuo de proveedores.", href: "/soluciones/telco-as-a-service/" },
    { title: "IoT y SIM", text: "SIM/eSIM administradas, conectividad IoT y control de sensores.", href: "/soluciones/iot-sim/" }
  ];
  const appendServicesPopup = () => {
    if (!messages) return;
    const card = document.createElement("div");
    card.className = "bot olivia__services-card";
    card.innerHTML = `
      <strong>${copy.servicesTitle}</strong>
      <span>${copy.servicesIntro}</span>
      <ul>
        ${serviceLinks().map((service) => `
          <li>
            <a href="${service.href}">${service.title}</a>
            <small>${service.text}</small>
          </li>
        `).join("")}
      </ul>
    `;
    messages.append(card);
    messages.scrollTop = messages.scrollHeight;
  };
  const hideLeadForm = () => {
    leadFormVisible = false;
    leadFields?.setAttribute("hidden", "");
    if (input) {
      input.required = true;
      input.placeholder = copy.placeholder;
      input.value = "";
    }
  };
  const showLeadForm = (message: string) => {
    leadFormVisible = true;
    leadFields?.removeAttribute("hidden");
    if (detailsInput && !detailsInput.value.trim()) detailsInput.value = message;
    if (input) {
      input.required = false;
      input.value = "";
      input.placeholder = copy.details;
    }
    const prompt = document.createElement("p");
    prompt.className = "bot";
    prompt.textContent = copy.leadPrompt;
    messages?.append(prompt);
    messages?.scrollTo({ top: messages.scrollHeight });
  };
  const submitHubSpotLead = async (message: string) => {
    if (hubspotLeadSubmitted) return;
    const lead = leadDetails();
    const formData = new FormData();
    formData.set("formspreeEndpoint", "https://formspree.io/f/mzdnjgze");
    formData.set("name", lead.name);
    formData.set("company", lead.company);
    formData.set("email", lead.email);
    formData.set("phone", lead.phone);
    formData.set("message", lead.details || message);
    formData.set("language", english ? "en" : "es");
    const response = await fetch("/api/contact", { method: "POST", body: formData });
    if (!response.ok) throw new Error("Lead submission failed");
    hubspotLeadSubmitted = true;
    hideLeadForm();
  };
  const openPanel = () => {
    if (!panel || !open) return;
    panel.removeAttribute("hidden");
    panel.setAttribute("aria-hidden", "false");
    requestAnimationFrame(() => panel.classList.add("is-open"));
    open.setAttribute("hidden", "");
    window.setTimeout(() => input?.focus(), 280);
  };
  const closePanel = () => {
    if (!panel) return;
    panel.classList.remove("is-open");
    panel.setAttribute("aria-hidden", "true");
    window.setTimeout(() => {
      if (!panel.classList.contains("is-open")) panel.setAttribute("hidden", "");
      open?.removeAttribute("hidden");
    }, 240);
  };
  open?.addEventListener("click", openPanel);
  close?.addEventListener("click", closePanel);
  root?.querySelector("[data-services-open]")?.addEventListener("click", appendServicesPopup);
  privacyOpen?.addEventListener("click", () => privacy?.removeAttribute("hidden"));
  privacyClose?.addEventListener("click", () => privacy?.setAttribute("hidden", ""));
  privacyAccept?.addEventListener("click", () => {
    if (consentInput) consentInput.checked = true;
    localStorage.setItem("oliviaConsent:vialterna", "accepted");
    localStorage.setItem("oliviaConsentAt:vialterna", new Date().toISOString());
    privacy?.setAttribute("hidden", "");
  });
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const typedMessage = input?.value.trim() || "";
    const leadMessage = detailsInput?.value.trim() || "";
    const message = leadFormVisible ? leadMessage : typedMessage;
    if (!message || !messages || !input) return;
    if (!leadFormVisible && /\b(servicios?|services?|solutions?|soluciones?|edge|superwan|core|telco|iot|sim)\b/i.test(message)) {
      messages.insertAdjacentHTML("beforeend", `<p class="user">${message.replaceAll("<", "&lt;")}</p>`);
      input.value = "";
      appendServicesPopup();
      return;
    }
    const asksForHuman = /\b(hablar|contactar|contacten|contactarme|llamen|llamada|cotizaci[oó]n|presupuesto|asesor|experto|call me|contact me|talk to|speak to|quote|sales rep)\b/i.test(message);
    if (!hubspotLeadSubmitted && !leadFormVisible && asksForHuman) {
      messages.insertAdjacentHTML("beforeend", `<p class="user">${message.replaceAll("<", "&lt;")}</p>`);
      input.value = "";
      showLeadForm(message);
      return;
    }
    if (!hubspotLeadSubmitted && !hasCompleteLead()) {
      if (leadFormVisible) {
        const warning = document.createElement("p");
        warning.className = "bot";
        warning.textContent = copy.missingLead;
        messages.append(warning);
        messages.scrollTop = messages.scrollHeight;
        return;
      }
    }
    if (leadFormVisible && consentInput?.checked !== true) {
      const warning = document.createElement("p");
      warning.className = "bot";
      warning.textContent = copy.consentRequired;
      messages.append(warning);
      messages.scrollTop = messages.scrollHeight;
      return;
    }
    const lead = leadDetails();
    messages.insertAdjacentHTML("beforeend", `<p class="user">${message.replaceAll("<", "&lt;")}</p>`);
    input.value = "";
    const pending = document.createElement("p"); pending.className = "bot"; pending.textContent = "…"; messages.append(pending);
    try {
      if (leadFormVisible) await submitHubSpotLead(lead.details || message);
      await fetch(`${api}/widget/conversations`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          clientCode: "vialterna", visitorId, content: lead.details || message,
          visitorName: lead.name,
          email: lead.email,
          phone: lead.phone,
          source: "website", language: english ? "en" : "es",
          metadata: {
            page: location.pathname,
            pageUrl: location.href,
            pageTitle: document.title,
            pageContent: document.body.innerText.replace(/\s+/g, " ").slice(0, 5000),
            site: "vialterna2.vercel.app",
            lead,
            dataConsent: consentInput?.checked === true,
            consentVersion: "vialterna-privacy-chat-2026-07-01"
          }
        })
      });
      const response = await fetch(`${api}/olivia/chat`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          message: lead.details || message, language: english ? "en" : "es", clientCode: "vialterna",
          visitorId,
          metadata: {
            page: location.pathname,
            pageUrl: location.href,
            pageTitle: document.title,
            pageContent: document.body.innerText.replace(/\s+/g, " ").slice(0, 5000),
            lead
          }
        })
      });
      if (!response.ok) throw new Error("Chat request failed");
      const data = await response.json();
      pending.textContent = data.reply || "Un asesor Vialterna continuará contigo.";
      await fetch(`${api}/widget/conversations`, {
        method: "PATCH", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          clientCode: "vialterna", visitorId, content: pending.textContent,
          model: data.mode || "o7-olivia-ai"
        })
      });
    } catch { pending.textContent = copy.fallback; }
    messages.scrollTop = messages.scrollHeight;
  });
</script>

<style>
  .olivia{position:fixed;right:26px;bottom:26px;z-index:9999;font:15px/1.45 Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#f7f4ea}.olivia__teaser{display:flex;align-items:center;gap:12px;padding:12px 18px;border:1px solid #d8bd72;border-radius:999px;background:#17130d;color:#fff;box-shadow:0 18px 55px #000c,0 0 0 1px #d8bd7230;font-weight:800;transition:transform .2s ease,box-shadow .2s ease}.olivia__teaser:hover{transform:translateY(-3px);box-shadow:0 24px 65px #000d,0 0 28px #d8bd7238}.olivia__teaser b{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#d8bd72;color:#17130d}.olivia__panel{width:min(400px,calc(100vw - 28px));overflow:hidden;border:1px solid #a98a4c;border-radius:22px;background:#14120e;color:#fff;opacity:0;transform:translateY(28px) scale(.94);transform-origin:bottom right;box-shadow:0 35px 100px #000e,0 0 45px #d8bd7226,0 0 0 1px #d8bd7226;transition:opacity .22s ease,transform .28s cubic-bezier(.2,.9,.25,1.18)}.olivia__panel.is-open{opacity:1;transform:translateY(0) scale(1)}.olivia__panel header{display:grid;grid-template-columns:1fr auto auto;align-items:start;gap:12px;padding:18px 20px;background:linear-gradient(135deg,#211a0f,#17130d);border-bottom:1px solid #665334}.olivia__panel strong{display:block;font-family:Georgia,serif;font-size:29px;line-height:1;color:#dcc073;text-shadow:0 4px 20px #d8bd7230}.olivia__panel small{display:block;margin-top:6px;color:#d6d0c2;font-size:14px}.olivia__status{display:flex;align-items:center;gap:7px;margin-top:2px;padding:8px 12px;border:1px solid #4b4637;border-radius:999px;background:#272216;color:#d7d1c1;white-space:nowrap}.olivia__status i{width:10px;height:10px;border-radius:50%;background:#25c46b;box-shadow:0 0 0 4px #25c46b22,0 0 15px #25c46b}.olivia__status b{font-size:13px}.olivia__panel button{border:0;border-radius:999px;background:#d8bd72;color:#17130d;font-weight:800}.olivia__panel header button{width:42px;height:42px;font-size:24px;transition:transform .18s ease}.olivia__panel header button:hover{transform:rotate(8deg) scale(1.05)}.olivia__messages{height:290px;overflow:auto;padding:18px;background:#101010;color:#f4f0e7;background-image:linear-gradient(#ffffff08 1px,transparent 1px),radial-gradient(circle at 100% 0,#d8bd720b,transparent 42%);background-size:100% 42px,100% 100%}.olivia__messages p,.olivia__messages .bot{max-width:88%;margin:0 0 13px;padding:13px 15px;border-radius:16px;background:#242424;color:#f7f3ea;box-shadow:0 12px 30px #0006;animation:olivia-message-in .28s ease both}.olivia__messages .user{margin-left:auto;background:#d8bd72;color:#17130d}.olivia__quick-action{display:inline-flex;margin:2px 0 10px;padding:11px 15px!important;border:1px solid #d8bd72!important;background:#17130d!important;color:#fff!important;border-radius:10px!important}.olivia__services-card{max-width:96%!important}.olivia__services-card strong,.olivia__services-card span{display:block}.olivia__services-card ul{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:9px}.olivia__services-card li{padding:11px;border:1px solid #3b3426;border-radius:10px;background:#191919}.olivia__services-card a{display:block;color:#dcc073;font-weight:900;text-decoration:none}.olivia__services-card small{display:block;margin-top:4px;color:#d0d0d0}.olivia form{padding:14px 16px 16px;background:#14120e}.olivia label{display:flex;gap:9px;font-size:12px;color:#ddd6c8}.olivia label input{accent-color:#d8bd72}.olivia__privacy-link{border:0!important;background:transparent!important;color:#d8bd72!important;text-decoration:underline;padding:0!important;font:inherit!important}.olivia form div{display:flex;gap:10px;margin-top:11px}.olivia__lead-fields{display:grid!important;grid-template-columns:1fr 1fr;gap:10px}.olivia__lead-fields[hidden]{display:none!important}.olivia__lead-fields input,.olivia__lead-fields textarea,.olivia form input[data-input]{min-width:0;padding:12px 13px;border:1px solid #3a3427;border-radius:12px;background:#fff;color:#161616;font:inherit}.olivia__lead-fields textarea{grid-column:1/-1;min-height:88px;resize:vertical}.olivia form input[data-input]{flex:1}.olivia form button[data-send]{min-width:78px;border-radius:12px}.olivia__privacy{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;background:#0009;padding:18px}.olivia__privacy[hidden]{display:none}.olivia__privacy>div{position:relative;max-width:560px;border:1px solid #d8bd72;border-radius:18px;background:#111;color:#f7f3ea;padding:24px;box-shadow:0 24px 70px #0008}.olivia__privacy h3{margin:0 0 12px;color:#dcc073}.olivia__privacy p{font-size:14px;line-height:1.55}.olivia__privacy a{display:inline-block;margin-right:12px;color:#d8bd72}.olivia__privacy button{border:0;border-radius:10px;background:#d8bd72;color:#17130d;padding:10px 14px;font-weight:800}.olivia__privacy button:first-child{position:absolute;right:12px;top:10px;background:transparent;color:#fff;font-size:22px;padding:0}@keyframes olivia-message-in{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.olivia__panel,.olivia__teaser,.olivia__messages p{transition:none;animation:none}}@media(max-width:560px){.olivia{right:12px;bottom:12px}.olivia__panel{width:calc(100vw - 24px);max-height:calc(100vh - 24px)}.olivia__panel header{grid-template-columns:1fr auto}.olivia__status{display:none}.olivia__messages{height:min(290px,40vh)}.olivia__lead-fields{grid-template-columns:1fr}.olivia form div{align-items:stretch}.olivia form button[data-send]{min-width:70px}.olivia__teaser{padding:10px 14px}}
</style>
