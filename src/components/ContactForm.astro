---
interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";
const defaultFormspreeEndpoint = "https://formspree.io/f/mzdnjgze";
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || defaultFormspreeEndpoint;
const formAction = formspreeEndpoint;
const isFormConfigured = Boolean(formspreeEndpoint);
const siteUrl = import.meta.env.SITE || "https://www.vialterna.com";
const thankYouPath = isEnglish ? "/en/contact/?sent=1" : "/contacto/?sent=1";
const copy = isEnglish
  ? {
      kicker: "Contact form",
      title: "Start with a diagnostic",
      intro: "We analyze your connectivity infrastructure, carrier contracts, spend, redundancy and performance to identify disconnection risks and optimization opportunities.",
      name: "Name",
      company: "Company",
      email: "Email",
      phone: "Phone",
      message: "How can we help?",
      submit: "Send",
      notConfigured: "Form endpoint is not configured yet."
    }
  : {
      kicker: "Formulario de contacto",
      title: "Empieza con un diagnóstico",
      intro: "Analizamos tu infraestructura de conectividad, contratos con operadores, gasto, redundancias y desempeño para identificar riesgos de desconexión y oportunidades de optimización.",
      name: "Nombre",
      company: "Empresa",
      email: "Correo",
      phone: "Teléfono",
      message: "Cómo podemos ayudarte",
      submit: "Enviar",
      notConfigured: "El endpoint del formulario todavía no está configurado."
    };
---
<section class="section contact-form-section" aria-labelledby={`contact-form-title-${lang}`}>
  <div class="shell">
    <div class="contact-form-panel">
      <div class="contact-form-header">
        <div class="kicker">{copy.kicker}</div>
        <h2 id={`contact-form-title-${lang}`}>{copy.title}</h2>
        <p>{copy.intro}</p>
      </div>
      <form class="contact-form" action={formAction} method="POST">
        <input type="hidden" name="_subject" value={isEnglish ? "New Vialterna website lead" : "Nuevo lead desde el sitio Vialterna"} />
        <input type="hidden" name="_next" value={`${siteUrl}${thankYouPath}`} />
        <input type="hidden" name="source" value="vialterna-website-contact-form" />
        <input type="hidden" name="language" value={lang} />
        <div class="contact-form-grid">
          <label>
            <span>{copy.name}<i aria-hidden="true">*</i></span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>{copy.company}<i aria-hidden="true">*</i></span>
            <input type="text" name="company" autocomplete="organization" required />
          </label>
          <label>
            <span>{copy.email}<i aria-hidden="true">*</i></span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            <span>{copy.phone}<i aria-hidden="true">*</i></span>
            <input type="tel" name="phone" autocomplete="tel" required />
          </label>
        </div>
        <label>
          <span>{copy.message}</span>
          <textarea name="message" rows="5"></textarea>
        </label>
        {!isFormConfigured && <p class="form-warning">{copy.notConfigured}</p>}
        <button class="button primary" type="submit" disabled={!isFormConfigured}>{copy.submit} <span aria-hidden="true">→</span></button>
      </form>
    </div>
  </div>
</section>
