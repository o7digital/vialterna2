---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { insightPostsEn } from "../../../data/insightsEn";
import { getBlogPosts } from "../../../lib/dato";
import { absoluteUrl } from "../../../lib/seo";

export async function getStaticPaths() {
  const posts = await getBlogPosts("en", insightPostsEn);
  return posts.flatMap((post) => {
    const paths = [{
      params: { slug: post.slug },
      props: { post }
    }];

    if ("originalSlug" in post && typeof post.originalSlug === "string") {
      paths.push({
        params: { slug: post.originalSlug },
        props: { post }
      });
    }

    return paths;
  });
}

const { post } = Astro.props;
const description = post.excerpt;
const canonical = absoluteUrl(`/en/insights/${post.slug}/`);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description,
  image: post.image ? absoluteUrl(post.image) : undefined,
  datePublished: post.date,
  author: { "@type": "Person", name: post.author },
  publisher: {
    "@type": "Organization",
    name: "Vialterna",
    url: absoluteUrl("/"),
    logo: { "@type": "ImageObject", url: absoluteUrl("/brand/vialterna-logo-white.svg") }
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  inLanguage: "en",
  articleSection: post.categories.join(", ")
};
const formatDate = (date: string) => new Intl.DateTimeFormat("en", {
  day: "2-digit",
  month: "long",
  year: "numeric"
}).format(new Date(date));
---
<BaseLayout
  title={`${post.title} | Vialterna`}
  description={description}
  lang="en"
  image={post.image || undefined}
  type="article"
  publishedTime={post.date}
  author={post.author}
  articleTags={post.categories}
  structuredData={structuredData}
>
  <Header lang="en" />
  <main>
    <article>
      <section class="editorial-hero insight-detail-hero">
        <div class="shell">
          <div class="eyebrow reveal">{post.categories.join(" / ") || "Insights"}</div>
          <h1 class="detail-title reveal">{post.title}</h1>
          <p class="detail-lead reveal">{formatDate(post.date)} · {post.author}</p>
        </div>
      </section>

      <section class="section insight-detail-section">
        <div class="shell insight-detail">
          {post.image && <img class="insight-detail-image reveal" src={post.image} alt={post.imageAlt ?? post.title} loading="lazy" decoding="async" />}
          <div class="insight-content" set:html={post.content} />
          <a class="back-to-insights" href="/en/insights/">Back to insights</a>
        </div>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>
