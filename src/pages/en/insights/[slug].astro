---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { insightPostsEn } from "../../../data/insightsEn";

export function getStaticPaths() {
  return insightPostsEn.flatMap((post) => [
    {
      params: { slug: post.slug },
      props: { post }
    },
    {
      params: { slug: post.originalSlug },
      props: { post }
    }
  ]);
}

const { post } = Astro.props;
const description = post.excerpt;
const formatDate = (date: string) => new Intl.DateTimeFormat("en", {
  day: "2-digit",
  month: "long",
  year: "numeric"
}).format(new Date(date));
---
<BaseLayout title={`${post.title} | Vialterna`} description={description} lang="en">
  <Header lang="en" />
  <main>
    <article>
      <section class="editorial-hero insight-detail-hero">
        <div class="shell">
          <div class="eyebrow reveal">{post.categories.join(" / ") || "Insights"}</div>
          <h1 class="detail-title reveal">{post.title}</h1>
          <p class="detail-lead reveal">{formatDate(post.date)} · {post.author}</p>
        </div>
      </section>

      <section class="section insight-detail-section">
        <div class="shell insight-detail">
          {post.image && <img class="insight-detail-image reveal" src={post.image} alt="" />}
          <div class="insight-content" set:html={post.content} />
          <a class="back-to-insights" href="/en/insights/">Back to insights</a>
        </div>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>
